---
interface Props {
  href: string;
  date: Date;
  title: string;
  description: string;
  tags?: string[];
}

const { href, date, title, description, tags = [] } = Astro.props;
const dateLabel = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<a class="list-item" href={href}>
  <span class="list-item__meta">{dateLabel}</span>
  <span>
    <span class="list-item__title">{title}</span>
    <span class="list-item__desc">{description}</span>
  </span>
  {
    tags.length > 0 && (
      <span class="list-item__tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </span>
    )
  }
</a>

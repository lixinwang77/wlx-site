---

<nav class="social-row" aria-label="社交媒体">
  {
    siteConfig.socials.map((item) => {
      const external = 'external' in item ? item.external !== false : true;
      return (
        <a
          class="social-link"
          href={item.href}
          aria-label={item.label}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          <span set:html={icons[item.icon] ?? icons.github} />
        </a>
      );
    })
  }
</nav>

<div class="cursor-sparkles" aria-hidden="true">
  <canvas id="cursor-sparkles-canvas"></canvas>
</div>

<style>
  .cursor-sparkles {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    overflow: hidden;
  }

  .cursor-sparkles canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const prefersCoarsePointer = window.matchMedia('(pointer: coarse)').matches;

  if (!prefersReducedMotion && !prefersCoarsePointer) {
    const canvas = document.getElementById('cursor-sparkles-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) throw new Error('Sparkle canvas not found');

    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas context unavailable');

    const colors = ['#6e2f3c', '#8a4a56', '#5c6b5a', '#d7cdbf', '#f4efe6'];
    const particles: Array<{
      x: number;
      y: number;
      size: number;
      rotation: number;
      opacity: number;
      life: number;
      maxLife: number;
      driftX: number;
      driftY: number;
      twinkle: number;
      color: string;
    }> = [];

    let width = 0;
    let height = 0;
    let lastSpawn = 0;
    let lastX = -100;
    let lastY = -100;
    let rafId = 0;

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    function spawn(x: number, y: number, count = 1) {
      for (let i = 0; i < count; i += 1) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 0.15 + Math.random() * 0.35;

        particles.push({
          x: x + (Math.random() - 0.5) * 10,
          y: y + (Math.random() - 0.5) * 10,
          size: 2 + Math.random() * 4,
          rotation: Math.random() * Math.PI,
          opacity: 0.5 + Math.random() * 0.5,
          life: 0,
          maxLife: 28 + Math.random() * 24,
          driftX: Math.cos(angle) * speed,
          driftY: Math.sin(angle) * speed - 0.08,
          twinkle: Math.random() * Math.PI * 2,
          color: colors[Math.floor(Math.random() * colors.length)] ?? colors[0],
        });
      }
    }

    function drawStar(
      x: number,
      y: number,
      size: number,
      rotation: number,
      opacity: number,
      color: string,
    ) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(rotation);
      ctx.globalAlpha = opacity;
      ctx.fillStyle = color;
      ctx.beginPath();

      const spikes = 4;
      const outer = size;
      const inner = size * 0.35;

      for (let i = 0; i < spikes * 2; i += 1) {
        const radius = i % 2 === 0 ? outer : inner;
        const angle = (Math.PI / spikes) * i - Math.PI / 2;
        const px = Math.cos(angle) * radius;
        const py = Math.sin(angle) * radius;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }

      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    function tick(now: number) {
      ctx.clearRect(0, 0, width, height);

      for (let i = particles.length - 1; i >= 0; i -= 1) {
        const p = particles[i];
        if (!p) continue;

        p.life += 1;
        p.x += p.driftX;
        p.y += p.driftY;
        p.rotation += 0.04;

        const progress = p.life / p.maxLife;
        const fade = 1 - progress * progress;
        const twinkle = 0.55 + Math.sin(p.life * 0.35 + p.twinkle) * 0.45;

        drawStar(p.x, p.y, p.size * (1 - progress * 0.35), p.rotation, p.opacity * fade * twinkle, p.color);

        if (p.life >= p.maxLife) particles.splice(i, 1);
      }

      rafId = window.requestAnimationFrame(tick);
    }

    function onMove(event: MouseEvent) {
      const now = performance.now();
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      const distance = Math.hypot(dx, dy);

      if (now - lastSpawn > 24 && distance > 4) {
        const steps = Math.min(3, Math.max(1, Math.floor(distance / 18)));
        spawn(event.clientX, event.clientY, steps);
        lastSpawn = now;
        lastX = event.clientX;
        lastY = event.clientY;
      }
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', onMove, { passive: true });
    rafId = window.requestAnimationFrame(tick);

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.cancelAnimationFrame(rafId);
        window.removeEventListener('resize', resize);
        window.removeEventListener('mousemove', onMove);
      },
      { once: true },
    );
  }
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ContentListItem from '../components/ContentListItem.astro';
import WorkCard from '../components/WorkCard.astro';
import { siteConfig } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const entries = [
  {
    href: '/blog',
    mark: '壹',
    label: '札记',
    title: '博客',
    body: '经验、思考与学习笔记，按文章慢慢沉淀。',
  },
  {
    href: '/works',
    mark: '贰',
    label: '近作',
    title: '作品',
    body: '做过的应用与项目，可下载体验。',
  },
  {
    href: siteConfig.github,
    mark: '叁',
    label: '源码',
    title: '开源',
    body: '代码与实验放在 GitHub，欢迎来逛逛。',
    external: true,
  },
] as const;
---

<BaseLayout>
  <Header slot="header" />

  <section class="shell hero">
    <div class="hero__copy">
      <p class="eyebrow reveal">札记与近作</p>
      <h1 class="hero__title reveal reveal-delay-1">
        写一点经验，
        <em>留一点作品。</em>
      </h1>
      <p class="lead reveal reveal-delay-2">{siteConfig.tagline}</p>
      <div class="reveal reveal-delay-3">
        <SocialLinks />
      </div>
    </div>

    <nav class="index-list reveal reveal-delay-2" aria-label="站点入口">
      {
        entries.map((entry) => (
          <a
            class="index-item"
            href={entry.href}
            target={'external' in entry ? '_blank' : undefined}
            rel={'external' in entry ? 'noopener noreferrer' : undefined}
          >
            <span class="index-item__mark">{entry.mark}</span>
            <span class="index-item__body">
              <span class="index-item__label">{entry.label}</span>
              <strong>{entry.title}</strong>
              <span class="index-item__desc">{entry.body}</span>
            </span>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">近文</p>
        <h2>最新文章</h2>
      </div>
      <a class="btn btn-ghost" href="/blog">查看全部</a>
    </div>
    <div class="list">
      {
        posts.slice(0, 3).map((post) => (
          <ContentListItem
            href={`/blog/${post.id}`}
            date={post.data.pubDate}
            title={post.data.title}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">近作</p>
        <h2>精选作品</h2>
      </div>
      <a class="btn btn-ghost" href="/works">查看全部</a>
    </div>
    <div class="work-grid">
      {
        works.slice(0, 6).map((work, index) => (
          <WorkCard
            class={`reveal${index ? ` reveal-delay-${Math.min(index, 3)}` : ''}`}
            href={`/works/${work.id}`}
            title={work.data.title}
            description={work.data.description}
            tags={work.data.tags}
            cover={work.data.cover}
            featured={index === 0}
          />
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

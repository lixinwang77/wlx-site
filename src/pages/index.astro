---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ContentListItem from '../components/ContentListItem.astro';
import { siteConfig } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
  <Header slot="header" />

  <section class="shell hero">
    <p class="eyebrow reveal">Personal Notes & Works</p>
    <h1 class="hero__title reveal reveal-delay-1">
      写一点经验，<em>留一点作品。</em>
    </h1>
    <p class="lead reveal reveal-delay-2">{siteConfig.tagline}</p>
    <div class="reveal reveal-delay-3">
      <SocialLinks />
    </div>
  </section>

  <section class="shell section section--entries">
    <div class="entry-grid">
      <a class="entry-card reveal" href="/blog">
        <span class="entry-card__label">Collection</span>
        <h2>博客</h2>
        <p>经验、思考与学习笔记，按文章慢慢沉淀。</p>
      </a>
      <a class="entry-card reveal reveal-delay-1" href="/works">
        <span class="entry-card__label">Works</span>
        <h2>作品</h2>
        <p>做过的项目与尝试，图文与视频分开呈现。</p>
      </a>
      <a
        class="entry-card reveal reveal-delay-2"
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="entry-card__label">GitHub</span>
        <h2>开源</h2>
        <p>代码与实验放在 GitHub，欢迎来逛逛。</p>
      </a>
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Latest</p>
        <h2>最新文章</h2>
      </div>
      <a class="btn btn-ghost" href="/blog">查看全部 →</a>
    </div>
    <div class="list">
      {
        posts.slice(0, 3).map((post) => (
          <ContentListItem
            href={`/blog/${post.id}`}
            date={post.data.pubDate}
            title={post.data.title}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>

  <section class="shell section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected</p>
        <h2>精选作品</h2>
      </div>
      <a class="btn btn-ghost" href="/works">查看全部 →</a>
    </div>
    <div class="list">
      {
        works.slice(0, 3).map((work) => (
          <ContentListItem
            href={`/works/${work.id}`}
            date={work.data.pubDate}
            title={work.data.title}
            description={work.data.description}
            tags={work.data.tags}
          />
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

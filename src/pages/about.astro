---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout title="关于" description={`关于 ${siteConfig.author}`}>
  <Header slot="header" />

  <section class="shell page-hero">
    <p class="eyebrow">About</p>
    <h1>关于</h1>
    <div class="prose">
      <p>
        你好，我是 {siteConfig.author}。这里是我的个人站点：一边写博客分享经验，一边单独展示作品。
      </p>
      <p>
        站点定位很简单——内容真实、结构清楚、动效克制。博客用来沉淀文字，作品用来呈现项目，社交媒体入口方便你找到我。
      </p>
      <p>后续会继续完善内容。社交账号链接可以在配置文件里替换成你的真实地址。</p>
    </div>
    <div style="margin-top: 2rem;">
      <SocialLinks />
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

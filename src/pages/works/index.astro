---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(works.flatMap((work) => work.data.tags))];
const countLabel = new Intl.NumberFormat('zh-Hans-CN-u-nu-hanidec').format(works.length);
---

<BaseLayout title="作品" description="做过的应用与项目展示。">
  <Header slot="header" />

  <section class="shell page-hero">
    <p class="eyebrow">近作</p>
    <h1>作品</h1>
    <p class="lead">做过的应用与项目，共{countLabel}件，可下载或在线体验。</p>
  </section>

  <section class="shell section" style="padding-top: 0;">
    <div class="filter-bar" data-filter-bar aria-label="作品类型">
      <button type="button" data-filter="all" aria-current="page">全部</button>
      {tags.map((tag) => <button type="button" data-filter={tag}>{tag}</button>)}
    </div>

    <div class="work-grid" data-filter-list>
      {
        works.map((work, index) => (
          <WorkCard
            href={`/works/${work.id}`}
            title={work.data.title}
            description={work.data.description}
            tags={work.data.tags}
            cover={work.data.cover}
            featured={index === 0}
            data-tags={work.data.tags.join(',')}
          />
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const bar = document.querySelector('[data-filter-bar]');
  const list = document.querySelector('[data-filter-list]');
  if (bar && list) {
    bar.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const filter = target.dataset.filter ?? 'all';
      bar.querySelectorAll('button').forEach((button) => {
        if (button !== target) button.removeAttribute('aria-current');
      });
      target.setAttribute('aria-current', 'page');
      list.querySelectorAll('[data-tags]').forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const tags = item.dataset.tags?.split(',').filter(Boolean) ?? [];
        item.hidden = filter !== 'all' && !tags.includes(filter);
      });
      list.toggleAttribute('data-compact', filter !== 'all');
    });
  }
</script>
